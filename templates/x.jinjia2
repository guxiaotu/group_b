<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <title>上架月份分布分析</title>
    <script src="/static/js/echarts.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
            background: #f0f2f5;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
            font-size: 22px;
        }
        .chart-box {
            background: #fff;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        }
    </style>
</head>
<body>

<h1>上架月份分布分析</h1>

<div class="chart-box">
    <div id="combo-chart" style="width: 100%; height: 520px;"></div>
</div>

<script>
    // ---- 数据（后端注入） ----
    const month = {{ x.month | tojson | safe }};
    const count = {{ x.count | tojson | safe }};
    const ratios = {{ x.ratios | tojson | safe }};
    const sample_count = {{ sample_count | tojson | safe }};

    // ---- 组合图：柱状=当月数量 + 折线=累计 ----
    const chart = echarts.init(document.getElementById('combo-chart'));
    chart.setOption({
        title: {
            text: '每月上架商品数量 & 累计趋势',
            left: 'center',
            top: 0,
            textStyle: { fontSize: 16 }
        },
        tooltip: {
            trigger: 'axis',
            axisPointer: { type: 'cross' }
        },
        legend: {
            data: ['当月商品数量', '样本占比(%)', '累计数量'],
            top: 36
        },
        grid: {
            left: '3%', right: '4%', bottom: '12%', top: 80, containLabel: true
        },
        xAxis: {
            type: 'category',
            data: month,
            axisLabel: {
                rotate: 45,
                interval: Math.floor(month.length / 15),
                fontSize: 10
            }
        },
        yAxis: [
            {
                type: 'value',
                name: '商品数量',
                position: 'left',
                axisLine: { show: true, lineStyle: { color: '#5470c6' } },
                axisLabel: { color: '#5470c6' }
            },
            {
                type: 'value',
                name: '累计数量',
                position: 'right',
                axisLine: { show: true, lineStyle: { color: '#ee6666' } },
                axisLabel: { color: '#ee6666' }
            }
        ],
        dataZoom: [
            { type: 'slider', start: 65, end: 100 },
            { type: 'inside' }
        ],
        series: [
            {
                name: '当月商品数量',
                type: 'bar',
                data: count,
                yAxisIndex: 0,
                barMaxWidth: 18,
                itemStyle: {
                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                        { offset: 0, color: '#5470c6' },
                        { offset: 1, color: '#91cc75' }
                    ])
                }
            },
            {
                name: '样本占比(%)',
                type: 'line',
                data: ratios,
                yAxisIndex: 0,
                symbol: 'circle',
                symbolSize: 3,
                lineStyle: { type: 'dashed', color: '#91cc75' },
                itemStyle: { color: '#91cc75' }
            },
            {
                name: '累计数量',
                type: 'line',
                data: sample_count,
                yAxisIndex: 1,
                smooth: true,
                lineStyle: { width: 2.5, color: '#ee6666' },
                areaStyle: {
                    color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                        { offset: 0, color: 'rgba(238,102,102,0.25)' },
                        { offset: 1, color: 'rgba(238,102,102,0.02)' }
                    ])
                }
            }
        ]
    });

    // 自适应
    window.addEventListener('resize', function() {
        chart.resize();
    });
</script>

</body>
</html>